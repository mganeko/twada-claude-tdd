{
  "name": "twada-claude-tdd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --enable-source-maps --import @power-assert/node --test \"src/**/*.test.ts\"",
    "test:coverage": "node --enable-source-maps --import @power-assert/node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/__tests__/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@power-assert/node": "^0.7.2",
    "@power-assert/runtime": "^0.3.2",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
